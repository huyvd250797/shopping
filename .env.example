# MyShop V1.0.0 production environment

# Public Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Legacy fallback only if your Supabase project still uses anon keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site / canonical production URL
NEXT_PUBLIC_SHOP_NAME=MyShop
NEXT_PUBLIC_SITE_URL=https://bobebunne.vercel.app

# Server-only bootstrap Admin credentials.
# Used only by scripts/seed-admin.mjs. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe-Strong-Password
ADMIN_SEED_NAME=Administrator

# OPTIONAL local/CI database backup connection string.
# Do not expose to browser and do not commit a real value.
# Recommended: Supabase direct/session-pooler Postgres connection string with SSL.
SUPABASE_DB_URL=
